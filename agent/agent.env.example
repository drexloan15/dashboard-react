# ══════════════════════════════════════════════════════════════════
#  agent.env.example — Copiar como "agent.env" y completar valores.
#  NUNCA subir agent.env a git (está en .gitignore).
# ══════════════════════════════════════════════════════════════════

# ─── A donde enviar los datos (agente_lexmark, pr_stats_agent) ────
# Red A y Red B NO comparten LAN: el unico camino es el tunel cloudflared
# que expone api_server.py en Red B.
#
# Hay dos formas de configurarlo. Elegir UNA:
#
# (A) API_URL fija. Simple, pero el quick tunnel gratuito cambia de URL en
#     cada reinicio de cloudflared, y entonces hay que editar este archivo
#     en CADA maquina agente de Red A.
#API_URL=https://algo-aleatorio.trycloudflare.com
#
# (B) API_URL_FILE: la URL vive en UN solo sitio y todos los agentes la leen
#     al arrancar. Cuando el tunel rota, se actualiza ahi y listo -- no se
#     toca ninguna maquina agente, ni se reempaqueta ningun .exe.
#     Admite una carpeta compartida de Red A o una URL publica:
#API_URL_FILE=\\SERVIDOR\monitoreo\api_url.txt
#API_URL_FILE=https://gist.githubusercontent.com/USUARIO/ID/raw/api_url.txt
#
# Contenido de ese archivo: la primera linea que no este vacia ni empiece
# con '#'.  Ej:
#     # actualizado por el script de cloudflared en Red B
#     https://algo-aleatorio.trycloudflare.com
#
# Si API_URL_FILE no responde, el agente reutiliza la ultima URL que le
# funciono (cache .api_url.cache junto al .exe) y lo avisa en el log, en vez
# de perder el ciclo. API_URL, si esta puesta, siempre gana sobre el archivo.
API_URL_FILE=\\SERVIDOR\monitoreo\api_url.txt

# Segundos de espera al leer API_URL_FILE (default 10)
# API_URL_FILE_TIMEOUT=10

# Clave compartida entre agentes y api_server — generar con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
AGENT_API_KEY=REEMPLAZAR_CON_CLAVE_GENERADA

# ─── Base de datos PostgreSQL (usada por: api_server) ─────────────
# api_server corre como contenedor DENTRO del stack vantio-monitoreo, asi
# que habla con Postgres por la red interna de Docker: host "db", puerto
# 5432 (el puerto interno del contenedor).
#
# !! NO cambiar a localhost:5432 !!  En el HOST 192.168.1.51 el 5432 es el
# PostgreSQL del stack VANTIO (otro proyecto). El Postgres de monitoreo
# esta publicado en el host como 5433. Apuntar a localhost:5432 escribiria
# en la base de datos equivocada.
DB_HOST=db
DB_PORT=5432
DB_NAME=lexmark_monitor
DB_USER=lexmark_user
DB_PASSWORD=REEMPLAZAR_CON_PASSWORD_BD

# ─── Firebird (usada por: pr_stats_agent) ────────────────────────
FIREBIRD_HOST=localhost
FIREBIRD_DB=C:\Program Files\Lexmark\Solutions\firebird\data\SOLUTIONINFO.FDB
FIREBIRD_USER=SYSDBA
# Cambiar la contraseña por defecto "masterkey" desde Firebird antes de producción
FIREBIRD_PASSWORD=REEMPLAZAR_CON_PASSWORD_FIREBIRD
FIREBIRD_CHARSET=UTF8
FIREBIRD_LIB=C:\Program Files\Lexmark\Solutions\firebird\fbclient.dll

# ─── Opcionales (agente_lexmark) ─────────────────────────────────
# API_TIMEOUT=60
# SNMP_MAX_WORKERS=20
# SNMP_TIMEOUT=2.0
# SNMP_COMMUNITY=public

# ─── Opcionales (pr_stats_agent) ─────────────────────────────────
# API_TIMEOUT=120
# BATCH_SIZE=500
# FECHA_INICIO=2026-04-23
