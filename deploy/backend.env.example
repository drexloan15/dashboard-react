# Copiar como "backend.env" en ~/vantio-monitoreo (chmod 600). NO va a git.
# Lo consume el contenedor monitoreo-backend.

# db:5432 es la red interna de Docker. En el HOST el 5432 es el PostgreSQL
# del stack VANTIO; el de monitoreo esta publicado en el 5433.
DATABASE_URL=postgresql://lexmark_user:REEMPLAZAR@db:5432/lexmark_monitor

# PIN de administrador. Sin esto, el acceso admin queda deshabilitado y las
# ediciones de inventario responden 503.
ADMIN_PIN=REEMPLAZAR

# Origenes autorizados para CORS, separados por coma.
ALLOWED_ORIGINS=http://192.168.1.51:3001,http://localhost:3001

# Correo de alertas y solicitudes (Gmail con contrasena de aplicacion)
EMAIL_FROM=REEMPLAZAR
EMAIL_PASS=REEMPLAZAR
EMAIL_TO=helpdesk@comutelperu.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# Watchdog del agente: horas sin dato nuevo en estado_actual antes de alertar
# por correo (agente/tunel caido). Opcional, por defecto 12.
AGENTE_ALERTA_HORAS=12

# Destinatario de las alertas de infraestructura (agente/tunel caido). Va
# solo al administrador del sistema, no a EMAIL_TO (helpdesk).
ALERTA_SISTEMA_EMAIL=jean.puccio@comutelperu.com
