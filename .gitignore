node_modules/
backend/monitoreo-impresoras.json
monitoreo-impresoras-a2198e85d49c.json
*.json.bak

# Secretos — NUNCA deben entrar a git
.env*
agent/agent.env
backend/.env
backend/.audit.log

# Logs generados en runtime
backend/audit.log
agent/*.log

# Agente: solo se ignoran secretos/artefactos, el código sí se trackea
# (cloudflared: el binario cae en agent/*.exe; sus credenciales en agent/.cloudflared/)
agent/.cloudflared/
agent/agent.env
agent/*.exe
agent/pr_stats_last_id.txt
agent/inventario2026.csv


# Python
__pycache__/
*.pyc

# Despliegue: el codigo de configuracion SI se trackea; los secretos reales
# no. Solo entran las plantillas *.example.
deploy/.env
deploy/*.env
!deploy/*.env.example
!deploy/env.example

# Volcados de base de datos: pueden pesar decenas de MB y llevan datos reales
*.dump
*.sql.gz

# Build artifacts
tsconfig.tsbuildinfo
*.tsbuildinfo

# Paquete de despliegue de los agentes (binarios + secretos)
agent/dist/

# Reportes internos de los agentes de revisión (funcional/seguridad/ux/rendimiento):
# detallan vulnerabilidades y debilidades del proyecto, no deben salir del equipo.
correcciones/
